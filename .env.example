# --- Database (any standard PostgreSQL connection string) ---
# Running via docker-compose (docker-compose.yml has no bundled Postgres — bring
# your own): if Postgres runs on your host machine, use "host.docker.internal"
# instead of "localhost" as the hostname, since the app runs inside a container.
# Running via `npm run dev` directly (no Docker): "localhost" is correct as-is.
DATABASE_URL="postgresql://user:password@localhost:5432/attendance?schema=public"
# Optional: direct (non-pooled) connection, used for migrations against pooled providers (Neon/Supabase)
DIRECT_URL="postgresql://user:password@localhost:5432/attendance?schema=public"

# --- App ---
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Admin session auth ---
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# --- File storage (company logo, employee photos, generated QR PDFs/PNGs) ---
# STORAGE_DRIVER selects the backend: "netlify" (default), "s3", or "local".
# See docs/SELF_HOSTING.md — only one of the three blocks below applies,
# matching whichever driver you choose.
STORAGE_DRIVER="netlify"

# netlify: Inside Netlify's own runtime (production, or `netlify dev`), the site
# ID and an access token are injected automatically — leave these two unset.
# Only needed for plain `next dev` without the Netlify CLI: get them from
# Netlify → Site settings → General (Site ID) and a Personal Access Token
# (User settings → OAuth applications → New access token).
NETLIFY_SITE_ID=""
NETLIFY_BLOBS_TOKEN=""

# s3: works with real AWS S3 or any S3-compatible self-hosted store (e.g. a MinIO
# container you run yourself). Leave S3_ENDPOINT unset for real AWS S3. On EC2,
# leave S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY unset too and attach an IAM role to
# the instance instead — see docs/DEPLOYMENT_AWS.md.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""             # e.g. "http://minio:9000" if you run MinIO yourself
S3_FORCE_PATH_STYLE="true" # required for MinIO; leave unset/false for AWS S3
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# local: single-server self-hosting only, writes to disk. Mount this path as a
# persistent Docker volume — do not use with more than one app replica/server.
STORAGE_LOCAL_DIR="./storage"

# --- Office Network Agent ---
# Used to derive per-agent registration token hashes; also referenced by network-agent/.env
NETWORK_AGENT_SECRET="replace-with-a-long-random-secret"

# --- QR token signing ---
QR_SECRET="replace-with-a-long-random-secret"

# --- Super admin seed (optional) ---
# When set, the `migrate` container (docker-compose.yml) automatically creates
# this SUPER_ADMIN on every startup if it doesn't already exist yet — safe to
# leave set indefinitely, it no-ops once the account exists (prisma/seed.ts).
# Leave both unset to skip seeding (e.g. after the admin account is created and
# you'd rather not keep the password sitting in .env).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""   # 10+ characters
SEED_ADMIN_NAME="Super Admin"

# --- Scheduled Function protection ---
# Shared secret that whatever calls /api/cron/* sends as
# "Authorization: Bearer <value>" — Netlify's netlify/functions/*.ts scheduled
# functions when on Netlify, or the `cron` container (deploy/cron/) when
# self-hosted. Same value either way.
CRON_SECRET="replace-with-a-long-random-secret"

# --- Outbound email (notifications) ---
# Optional: without these, the app logs a warning and skips sending instead of
# failing. See src/lib/email/send.ts.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# --- Trusted client-IP header (self-hosting only) ---
# The single most security-relevant setting when moving off Netlify: this is
# the header the app trusts as the employee's real IP for office-network
# attendance verification. Defaults to Netlify's own header, so leave unset on
# Netlify. Self-hosted behind deploy/nginx.conf, set this to "x-real-ip" —
# that config is written to always overwrite this header from the real TCP
# connection, so a client cannot spoof it. NEVER point this at a header your
# reverse proxy doesn't unconditionally overwrite. See
# src/lib/network/getClientIp.ts and docs/SELF_HOSTING.md.
TRUSTED_IP_HEADER="x-nf-client-connection-ip"
