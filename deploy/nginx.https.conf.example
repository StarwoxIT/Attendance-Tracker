# TLS + domain version of deploy/nginx.conf — use this once you have a domain
# pointed at this box. Copy over deploy/nginx.conf, fill in server_name and the
# cert paths, then run `certbot --nginx` against it for Let's Encrypt (bare IP
# addresses can't get a Let's Encrypt cert — a domain is required for this step).

server {
    listen 80;
    server_name attendance.yourcompany.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name attendance.yourcompany.com;

    ssl_certificate     /etc/letsencrypt/live/attendance.yourcompany.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/attendance.yourcompany.com/privkey.pem;

    client_max_body_size 10m; # logo/photo uploads are capped at 5MB app-side; leave headroom

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # SECURITY-CRITICAL: this is what the app trusts as the verified request
        # IP for office-network attendance checks (TRUSTED_IP_HEADER env var,
        # src/lib/network/getClientIp.ts). `proxy_set_header` always REPLACES any
        # incoming header of the same name from the client — it never appends —
        # so a client cannot forge this by sending their own X-Real-IP. Do not
        # change this to read from a client-supplied header instead.
        proxy_set_header X-Real-IP $remote_addr;
    }
}
