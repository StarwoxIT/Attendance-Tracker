// Digital Office Attendance & Clocking System — Prisma schema
// See docs/DATABASE.md for design notes.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (macOS/Windows/whatever machine runs `prisma generate`);
  // "rhel-openssl-3.0.x" is required for Netlify's actual serverless runtime, which
  // differs from most developers' local OS. "debian-openssl-3.0.x" is for the
  // self-hosted Docker image (deploy/Dockerfile uses node:20-slim, which is Debian-
  // based) — see docs/SELF_HOSTING.md. Without the right target here, a build only
  // ever bundles the engine for whichever platform ran `prisma generate` — fine
  // locally, broken once deployed if that platform doesn't match.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  HR
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(VIEWER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions       Session[]
  auditLogs      AuditLog[]
  qrCodesGenerated    AttendanceQrCode[] @relation("QrGeneratedBy")
  qrCodesDeactivated  AttendanceQrCode[] @relation("QrDeactivatedBy")
  attendanceCorrections AttendanceCorrection[]
  deviceFlagsReviewed AttendanceDeviceFlag[]
  deletionRequestsMade     EmployeeDeletionRequest[] @relation("DeletionRequestedBy")
  deletionRequestsReviewed EmployeeDeletionRequest[] @relation("DeletionReviewedBy")

  @@index([email])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Organization
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@map("departments")
}

model Office {
  id        String   @id @default(cuid())
  name      String
  address   String?
  timezone  String   @default("Africa/Lagos")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees       Employee[]
  officeNetworks  OfficeNetwork[]
  qrCodes         AttendanceQrCode[]
  attendanceRecords AttendanceRecord[]
  qrSessions      QrAttendanceSession[]
  notifications   Notification[]

  @@map("offices")
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  EXITED
}

model Employee {
  id               String           @id @default(cuid())
  employeeNumber   String           @unique
  // HMAC-SHA256(secret, normalized uppercase Attendance ID), hex-encoded.
  // Deterministic keyed hash: doubles as the unique index for O(1) lookup at
  // clock-in and as the stored credential — the plaintext ID is never persisted.
  // See lib/security/attendanceId.ts
  attendanceIdLookup String         @unique
  firstName        String
  middleName       String?
  lastName         String
  email            String?          @unique
  phone            String?
  departmentId     String?
  jobTitle         String?
  employmentStatus EmploymentStatus @default(ACTIVE)
  dateEmployed     DateTime?
  profilePhotoUrl  String?
  officeId         String
  // Optional per-employee override of the general "HH:mm" work schedule — falls
  // back to AttendanceSettings.workStart/workEnd (see attendance/rules.ts) when null.
  workStart        String?
  workEnd          String?
  // Soft-delete: hidden from all active lists and clock-in lookup once true, but the
  // row and its attendance history are preserved for reporting/audit and can be
  // restored. See EmployeeDeletionRequest for the approval workflow that sets this.
  isDeleted        Boolean          @default(false)
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  office     Office      @relation(fields: [officeId], references: [id])

  attendanceRecords AttendanceRecord[]
  attendanceIdHistory AttendanceIdHistory[]
  deviceFlagsAsCurrent  AttendanceDeviceFlag[] @relation("DeviceFlagEmployee")
  deviceFlagsAsPrevious AttendanceDeviceFlag[] @relation("DeviceFlagPreviousEmployee")
  deletionRequests  EmployeeDeletionRequest[]

  @@index([officeId])
  @@index([departmentId])
  @@index([employmentStatus])
  @@index([isDeleted])
  @@map("employees")
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Only SUPER_ADMIN can delete an employee immediately. ADMIN/HR can request a
 * deletion (reason required), which stays PENDING — and the employee stays fully
 * active — until a SUPER_ADMIN approves or rejects it. Approval soft-deletes the
 * employee (Employee.isDeleted); rejection leaves them untouched.
 */
model EmployeeDeletionRequest {
  id            String                 @id @default(cuid())
  employeeId    String
  requestedById String
  reason        String                 @db.VarChar(500)
  status        DeletionRequestStatus  @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime               @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedBy User     @relation("DeletionRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?    @relation("DeletionReviewedBy", fields: [reviewedById], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("employee_deletion_requests")
}

// Keeps an auditable trail every time an Attendance ID is regenerated.
model AttendanceIdHistory {
  id            String   @id @default(cuid())
  employeeId    String
  oldIdHash     String
  changedById   String?
  changedAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("attendance_id_history")
}

// ---------------------------------------------------------------------------
// Office network verification
// ---------------------------------------------------------------------------

enum NetworkStatus {
  VERIFIED
  STALE
  UNVERIFIED
  DISABLED
}

model OfficeNetwork {
  id                     String        @id @default(cuid())
  officeId               String
  name                   String
  currentPublicIp        String?
  cidr                   String?
  status                 NetworkStatus @default(UNVERIFIED)
  agentId                String?       @unique
  // One-time bootstrap credential (bcrypt hash only, never stored raw). Consumed
  // on first successful registration; admin regenerates it to re-pair an agent.
  registrationTokenHash  String?
  registrationTokenUsedAt DateTime?
  // Ongoing HMAC signing secret issued at registration, analogous to a webhook
  // signing secret — verifying a signature requires the raw key server-side,
  // so (unlike the registration token) it cannot be reduced to a hash.
  agentSigningSecret     String?
  lastVerifiedAt         DateTime?
  failMode               String        @default("FAIL_CLOSED") // FAIL_CLOSED | FAIL_OPEN
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  office     Office              @relation(fields: [officeId], references: [id], onDelete: Cascade)
  heartbeats NetworkHeartbeat[]

  @@index([officeId])
  @@map("office_networks")
}

model NetworkHeartbeat {
  id              String   @id @default(cuid())
  officeNetworkId String
  agentId         String
  sourceIp        String
  reportedIp      String
  timestamp       DateTime
  status          String
  createdAt       DateTime @default(now())

  officeNetwork OfficeNetwork @relation(fields: [officeNetworkId], references: [id], onDelete: Cascade)

  @@index([officeNetworkId, createdAt])
  @@map("network_heartbeats")
}

// ---------------------------------------------------------------------------
// Holidays
// ---------------------------------------------------------------------------

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @db.Date
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
  @@map("holidays")
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

enum ClockInStatus {
  EARLY
  ON_TIME
  LATE
  MISSED_CLOCK_OUT
  ABSENT
  MANUALLY_ADJUSTED
}

enum ClockOutStatus {
  EARLY
  ON_TIME
}

enum AttendanceType {
  REGULAR
  WEEKEND_OVERTIME
  HOLIDAY_OVERTIME
}

enum VerificationMethod {
  NETWORK
  QR_NETWORK
  QR_ONLY
  MANUAL_ADMIN
}

model AttendanceRecord {
  id                    String              @id @default(cuid())
  employeeId            String
  officeId              String
  attendanceDate        DateTime            @db.Date
  clockIn               DateTime?
  clockOut              DateTime?
  clockInStatus         ClockInStatus?
  clockOutStatus        ClockOutStatus?
  // Required whenever clockOutStatus is EARLY (employee clocked out before workEnd);
  // capped at 50 words, enforced both client-side and server-side. See lib/attendance/rules.ts.
  earlyClockOutReason   String?             @db.VarChar(400)
  attendanceType         AttendanceType      @default(REGULAR)
  minutesLate           Int                 @default(0)
  totalMinutesWorked    Int?
  clockInIp             String?
  clockOutIp            String?
  clockInUserAgent      String?
  clockOutUserAgent     String?
  clockInNetworkId      String?
  clockOutNetworkId     String?
  clockInQrId           String?
  clockOutQrId           String?
  // Persistent per-browser cookie ID (lib/security/deviceId.ts) — not a network
  // identity like clockInIp, which every device on office Wi-Fi shares via NAT.
  // Used to catch one device clocking in as different employees. See DeviceFlag.
  clockInDeviceId       String?
  clockOutDeviceId      String?
  verificationMethod    VerificationMethod?
  manualAdjustment      Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  office   Office   @relation(fields: [officeId], references: [id])

  corrections AttendanceCorrection[]
  deviceFlags AttendanceDeviceFlag[]

  @@unique([employeeId, attendanceDate])
  @@index([officeId, attendanceDate])
  @@index([attendanceDate])
  @@index([clockInDeviceId])
  @@map("attendance_records")
}

/**
 * Raised when a device (identified by its persistent cookie ID, not IP — every
 * device on office Wi-Fi shares one public IP via NAT, so IP can't distinguish
 * individual devices) clocks in as an employee it was NOT most recently seen
 * clocking in as. Never blocks the clock-in itself — flagged for admin review,
 * since shared devices (a reception tablet used as a fallback) are legitimate
 * and would otherwise false-positive constantly.
 */
model AttendanceDeviceFlag {
  id                 String    @id @default(cuid())
  deviceId           String
  attendanceRecordId String
  employeeId         String
  previousEmployeeId String
  createdAt          DateTime  @default(now())
  reviewed           Boolean   @default(false)
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNote         String?

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  employee         Employee         @relation("DeviceFlagEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  previousEmployee Employee         @relation("DeviceFlagPreviousEmployee", fields: [previousEmployeeId], references: [id], onDelete: Cascade)
  reviewedBy       User?            @relation(fields: [reviewedById], references: [id])

  @@index([deviceId])
  @@index([reviewed, createdAt])
  @@map("attendance_device_flags")
}

model AttendanceCorrection {
  id                  String   @id @default(cuid())
  attendanceRecordId  String
  changedById         String
  changedAt           DateTime @default(now())
  field               String
  originalValue       String?
  newValue            String?
  reason              String
  ipAddress           String?

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  changedBy        User             @relation(fields: [changedById], references: [id])

  @@index([attendanceRecordId])
  @@map("attendance_corrections")
}

// ---------------------------------------------------------------------------
// QR attendance
// ---------------------------------------------------------------------------

enum QrStatus {
  SCHEDULED
  ACTIVE
  EXPIRED
  DEACTIVATED
}

model AttendanceQrCode {
  id              String    @id @default(cuid())
  officeId        String
  attendanceDate  DateTime  @db.Date
  tokenHash       String    @unique
  tokenIdentifier String    @unique // short public identifier used in the URL, not secret
  validFrom       DateTime
  validUntil      DateTime
  status          QrStatus  @default(SCHEDULED)
  // Rendered once at generation time and stored in object storage so "download
  // anytime" works without ever persisting the raw secret token as DB text.
  pdfUrl          String?
  pngUrl          String?
  generatedById   String
  generatedAt     DateTime  @default(now())
  deactivatedById String?
  deactivatedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  office       Office                @relation(fields: [officeId], references: [id], onDelete: Cascade)
  generatedBy  User                  @relation("QrGeneratedBy", fields: [generatedById], references: [id])
  deactivatedBy User?                @relation("QrDeactivatedBy", fields: [deactivatedById], references: [id])
  sessions     QrAttendanceSession[]

  // Only one ACTIVE/SCHEDULED QR per office+day is enforced in application logic
  // (lib/qr/manage.ts, inside a transaction) since DEACTIVATED/EXPIRED rows must
  // be allowed to repeat across regenerations.
  @@index([officeId, attendanceDate])
  @@index([officeId, attendanceDate, status])
  @@map("attendance_qr_codes")
}

enum QrSessionStatus {
  ACTIVE
  USED
  EXPIRED
}

model QrAttendanceSession {
  id               String          @id @default(cuid())
  qrCodeId         String
  officeId         String
  sessionTokenHash String          @unique
  sourceIp         String
  userAgent        String?
  createdAt        DateTime        @default(now())
  expiresAt        DateTime
  usedAt           DateTime?
  status           QrSessionStatus @default(ACTIVE)

  qrCode AttendanceQrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  office Office           @relation(fields: [officeId], references: [id])

  @@index([qrCodeId])
  @@index([expiresAt])
  @@map("qr_attendance_sessions")
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

model CompanySettings {
  id              String   @id @default("singleton")
  companyName     String   @default("Company")
  logoUrl         String?
  primaryColor    String   @default("#0F766E")
  secondaryColor  String   @default("#0EA5E9")
  accentColor     String   @default("#F59E0B")
  address         String?
  phone           String?
  email           String?
  website         String?
  updatedAt       DateTime @updatedAt

  @@map("company_settings")
}

enum AttendanceMode {
  NETWORK_ONLY
  QR_AND_NETWORK
  QR_ONLY
}

model AttendanceSettings {
  id                       String         @id @default("singleton")
  timezone                 String         @default("Africa/Lagos")
  workStart                String         @default("09:00")
  gracePeriodMinutes        Int            @default(15)
  workEnd                  String         @default("17:00")
  attendanceMode            AttendanceMode @default(QR_AND_NETWORK)
  weekendIsOvertime         Boolean        @default(true)
  holidayIsOvertime         Boolean        @default(true)
  qrSessionMinutes           Int            @default(10)
  networkHeartbeatIntervalMinutes Int      @default(10)
  networkStaleThresholdMinutes    Int      @default(30)
  kioskResetSeconds          Int            @default(5)
  crossOfficeAttendance      Boolean        @default(false)
  updatedAt                 DateTime       @updatedAt

  @@map("attendance_settings")
}

// ---------------------------------------------------------------------------
// In-app / email notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  NETWORK_IP_CHANGED
  EMPLOYEE_DELETION_REQUESTED
}

/**
 * Broadcast to every active user with `targetRole` (currently always SUPER_ADMIN) —
 * not per-recipient, so "read" is shared across all of them. Fine at this org's
 * scale (a handful of admins); see lib/notifications/create.ts for dedupe logic
 * that stops one flaky network from spamming a notification per failed clock-in.
 */
model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  title      String
  message    String
  targetRole AdminRole
  officeId   String?
  read       Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  office Office? @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([targetRole, read, createdAt])
  @@index([type, officeId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  oldValue   String?
  newValue   String?
  reason     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Rate limiting (persistent — serverless-safe, no in-memory state)
// ---------------------------------------------------------------------------

model RateLimitBucket {
  key         String   @id // e.g. "attendance-id:203.0.113.4" or "admin-login:email"
  count       Int      @default(0)
  windowStart DateTime
  lockedUntil DateTime?

  @@map("rate_limit_buckets")
}
